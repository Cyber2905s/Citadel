# App connects as a non-owner role so Row-Level Security always applies.
DATABASE_URL=postgres://citadel_app:citadel_app@localhost:5432/citadel
# Owner/superuser connection used only by migrations.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/citadel
APP_DB_USER=citadel_app
APP_DB_PASSWORD=citadel_app
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PORT=3000
LOG_LEVEL=info
# Where invitation links point (the admin UI).
APP_URL=http://localhost:8080
